<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Illustrious Studio</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #0b0c10;
      --card: #14161d;
      --input: #1d202a;
      --border: rgba(255, 255, 255, 0.08);
      --border-hover: rgba(255, 255, 255, 0.18);
      --text: #f3f4f6;
      --muted: #9ca3af;
      --accent: #ec4899;
      --accent-glow: rgba(236, 72, 153, 0.28);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Inter', -apple-system, sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      -webkit-font-smoothing: antialiased;
    }

    /* Header */
    header {
      height: 56px;
      padding: 0 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid var(--border);
      background: rgba(11, 12, 16, 0.85);
      backdrop-filter: blur(12px);
      position: sticky;
      top: 0;
      z-index: 30;
    }
    .brand { display: flex; align-items: center; gap: 10px; font-weight: 600; font-size: 15px; letter-spacing: -0.02em; }
    .status-pill {
      display: flex; align-items: center; gap: 8px;
      background: var(--card); border: 1px solid var(--border);
      padding: 5px 12px; border-radius: 999px; font-size: 12px; color: var(--muted);
    }
    .dot { width: 7px; height: 7px; border-radius: 50%; background: #10b981; box-shadow: 0 0 8px rgba(16, 185, 129, 0.5); }

    /* Layout */
    .workspace {
      flex: 1;
      display: grid;
      grid-template-columns: 400px 1fr;
      gap: 20px;
      padding: 20px 20px 96px 20px;
      max-width: 1440px;
      width: 100%;
      margin: 0 auto;
    }
    @media (max-width: 900px) {
      .workspace { grid-template-columns: 1fr; padding: 14px 14px 96px 14px; }
    }

    .controls-col { display: flex; flex-direction: column; gap: 14px; }

    /* Cards */
    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 16px;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
    .card-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 14px;
      font-weight: 600;
    }
    .card-title { display: flex; align-items: center; gap: 8px; }

    /* Inputs & Selects */
    textarea, select, input[type="text"], input[type="number"] {
      width: 100%;
      background: var(--input);
      border: 1px solid var(--border);
      color: var(--text);
      font-family: inherit;
      font-size: 13px;
      border-radius: 10px;
      padding: 10px 12px;
      outline: none;
      transition: border-color 0.2s;
    }
    textarea:focus, select:focus, input:focus { border-color: var(--accent); }
    textarea { resize: vertical; line-height: 1.5; }

    .dim-row { display: flex; align-items: center; gap: 10px; }
    .dim-box { flex: 1; display: flex; align-items: center; gap: 8px; background: var(--input); border: 1px solid var(--border); border-radius: 10px; padding: 4px 10px; }
    .dim-box span { font-size: 12px; color: var(--muted); font-weight: 500; }
    .dim-box input { background: transparent; border: none; padding: 6px 0; text-align: center; }
    .swap-btn {
      background: var(--input); border: 1px solid var(--border); color: var(--muted);
      width: 36px; height: 36px; border-radius: 10px; display: flex; align-items: center; justify-content: center;
      cursor: pointer; flex-shrink: 0; transition: color 0.2s, border-color 0.2s;
    }
    .swap-btn:hover { color: var(--text); border-color: var(--border-hover); }

    /* Toggle Switch */
    .switch { position: relative; display: inline-block; width: 42px; height: 24px; flex-shrink: 0; }
    .switch input { opacity: 0; width: 0; height: 0; }
    .slider-round {
      position: absolute; cursor: pointer; inset: 0;
      background: #2b2f3c; border-radius: 999px; transition: 0.25s;
    }
    .slider-round:before {
      position: absolute; content: ""; height: 18px; width: 18px; left: 3px; bottom: 3px;
      background: #fff; border-radius: 50%; transition: 0.25s;
    }
    input:checked + .slider-round { background: var(--accent); box-shadow: 0 0 12px var(--accent-glow); }
    input:checked + .slider-round:before { transform: translateX(18px); }

    /* Range Slider + Number */
    .range-group { display: flex; flex-direction: column; gap: 8px; }
    .range-label { font-size: 12px; color: var(--muted); display: flex; justify-content: space-between; }
    .range-row { display: flex; align-items: center; gap: 12px; }
    input[type="range"] {
      flex: 1; -webkit-appearance: none; height: 4px; background: #2b2f3c; border-radius: 999px; outline: none;
    }
    input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance: none; width: 16px; height: 16px; border-radius: 50%;
      background: var(--accent); cursor: pointer; box-shadow: 0 0 8px var(--accent-glow);
    }
    .num-pill {
      width: 58px !important; text-align: center; padding: 6px !important; font-size: 12px !important;
    }

    .chip-row { display: flex; gap: 8px; }
    .chip {
      flex: 1; text-align: center; padding: 8px; border-radius: 10px; font-size: 12px; font-weight: 500;
      background: var(--input); border: 1px solid var(--border); color: var(--muted); cursor: pointer; transition: 0.2s;
    }
    .chip.active { background: rgba(236, 72, 153, 0.15); border-color: var(--accent); color: #fff; }

    .resize-info { font-size: 12px; color: var(--muted); background: rgba(255,255,255,0.03); padding: 8px 12px; border-radius: 8px; }

    /* Preview Gallery */
    .preview-col {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 20px;
      min-height: 420px;
      display: flex;
      flex-direction: column;
    }
    .empty { margin: auto; text-align: center; color: var(--muted); font-size: 13px; }
    .gallery { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; width: 100%; }
    .img-card {
      position: relative; background: var(--input); border: 1px solid var(--border);
      border-radius: 14px; overflow: hidden; aspect-ratio: 3 / 4; display: flex; align-items: center; justify-content: center;
    }
    .img-card img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .badge {
      position: absolute; top: 10px; left: 10px; background: rgba(11, 12, 16, 0.82);
      backdrop-filter: blur(6px); border: 1px solid var(--border); padding: 4px 10px;
      border-radius: 999px; font-size: 11px; font-weight: 500;
    }
    .prog { position: absolute; bottom: 0; left: 0; height: 3px; background: var(--accent); width: 0%; transition: width 0.15s; }
    .overlay {
      position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.8), transparent 35%);
      opacity: 0; transition: 0.2s; display: flex; align-items: flex-end; justify-content: space-between; padding: 14px;
    }
    .img-card:hover .overlay { opacity: 1; }
    .dl-btn { background: var(--accent); color: #fff; padding: 6px 14px; border-radius: 999px; font-size: 12px; font-weight: 600; text-decoration: none; }

    /* Sticky Bottom Bar */
    .bottom-bar {
      position: fixed;
      bottom: 0; left: 0; right: 0;
      background: rgba(11, 12, 16, 0.9);
      backdrop-filter: blur(16px);
      border-top: 1px solid var(--border);
      padding: 12px 20px;
      z-index: 40;
    }
    .bottom-inner {
      max-width: 1440px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .batch-btn, .gear-btn {
      background: var(--card); border: 1px solid var(--border); color: var(--text);
      height: 44px; padding: 0 14px; border-radius: 12px; font-size: 13px; font-weight: 600;
      display: flex; align-items: center; gap: 8px; cursor: pointer; flex-shrink: 0;
    }
    .batch-btn select { background: transparent; border: none; padding: 0; width: auto; font-weight: 600; cursor: pointer; }
    .gen-btn {
      flex: 1;
      height: 44px;
      background: linear-gradient(135deg, #ec4899, #d946ef);
      color: #fff;
      border: none;
      border-radius: 12px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      box-shadow: 0 4px 20px var(--accent-glow);
      transition: opacity 0.2s, transform 0.1s;
    }
    .gen-btn:hover { opacity: 0.92; }
    .gen-btn:active { transform: scale(0.99); }
    .gen-btn:disabled { opacity: 0.45; cursor: not-allowed; }

    /* Settings Modal */
    .modal-bg {
      position: fixed; inset: 0; background: rgba(0,0,0,0.75); backdrop-filter: blur(6px);
      display: none; align-items: center; justify-content: center; z-index: 50; padding: 16px;
    }
    .modal-bg.open { display: flex; }
    .modal {
      background: var(--card); border: 1px solid var(--border); border-radius: 18px;
      padding: 20px; width: 100%; max-width: 420px; display: flex; flex-direction: column; gap: 14px;
    }
  </style>
</head>
<body>

  <header>
    <div class="brand">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ec4899" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
        <polyline points="2 17 12 22 22 17"></polyline>
        <polyline points="2 12 12 17 22 12"></polyline>
      </svg>
      <span>Illustrious Studio</span>
    </div>
    <div class="status-pill">
      <span class="dot"></span>
      <span id="status_text">Ready</span>
    </div>
  </header>

  <div class="workspace">
    <div class="controls-col">
      <!-- Prompt Card -->
      <div class="card">
        <div class="card-head"><span>Prompt</span></div>
        <textarea id="prompt" rows="3" placeholder="Describe your scene...">masterpiece, best quality, amazing quality, 1girl, solo, looking at viewer, anime style</textarea>
        <textarea id="neg" rows="2" placeholder="Negative prompt...">bad quality, worst quality, worst detail, sketch, censor</textarea>
      </div>

      <!-- Canvas Size Card -->
      <div class="card">
        <div class="card-head"><span>Canvas Size</span></div>
        <select id="preset" onchange="applyPreset()">
          <option value="832,1216" selected>Portrait (832 x 1216)</option>
          <option value="1024,1344">Tall Portrait (1024 x 1344)</option>
          <option value="1216,832">Landscape (1216 x 832)</option>
          <option value="1024,1024">Square (1024 x 1024)</option>
          <option value="custom">Custom</option>
        </select>
        <div class="dim-row">
          <div class="dim-box"><span>W</span><input type="number" id="w_in" value="832" oninput="updateResizeInfo()" /></div>
          <button class="swap-btn" onclick="swapDims()" title="Swap">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="17 1 21 5 17 9"></polyline><path d="M3 11V9a4 4 0 0 1 4-4h14"></path>
              <polyline points="7 23 3 19 7 15"></polyline><path d="M21 13v2a4 4 0 0 1-4 4H3"></path>
            </svg>
          </button>
          <div class="dim-box"><span>H</span><input type="number" id="h_in" value="1216" oninput="updateResizeInfo()" /></div>
        </div>
      </div>

      <!-- ADetailer Card -->
      <div class="card">
        <div class="card-head">
          <span>ADetailer</span>
          <label class="switch">
            <input type="checkbox" id="ad_toggle" onchange="ad_body.style.display=this.checked?'flex':'none'" />
            <span class="slider-round"></span>
          </label>
        </div>
        <div id="ad_body" style="display:none; flex-direction:column; gap:12px;">
          <div class="chip-row">
            <div class="chip active" id="face_chip" onclick="this.classList.toggle('active')">Face Fix</div>
            <div class="chip" id="hand_chip" onclick="this.classList.toggle('active')">Hand Fix</div>
          </div>
          <div class="range-group">
            <div class="range-label"><span>Denoising Strength (0 - 1)</span></div>
            <div class="range-row">
              <input type="range" id="ad_str" min="0" max="1" step="0.05" value="0.4" oninput="ad_str_num.value=this.value" />
              <input type="number" class="num-pill" id="ad_str_num" value="0.4" step="0.05" oninput="ad_str.value=this.value" />
            </div>
          </div>
          <div class="range-group">
            <div class="range-label"><span>Mask Blur (1 - 40)</span></div>
            <div class="range-row">
              <input type="range" id="ad_blur" min="1" max="40" value="4" oninput="ad_blur_num.value=this.value" />
              <input type="number" class="num-pill" id="ad_blur_num" value="4" oninput="ad_blur.value=this.value" />
            </div>
          </div>
        </div>
      </div>

      <!-- Hires.fix / Upscaler Card -->
      <div class="card">
        <div class="card-head">
          <span>Hires.fix (Anime6B)</span>
          <label class="switch">
            <input type="checkbox" id="hr_toggle" onchange="hr_body.style.display=this.checked?'flex':'none'" />
            <span class="slider-round"></span>
          </label>
        </div>
        <div id="hr_body" style="display:none; flex-direction:column; gap:12px;">
          <div class="resize-info" id="resize_info">resize: from 832x1216 to 3328x4864 (4x)</div>
        </div>
      </div>
    </div>

    <!-- Live Preview Column -->
    <div class="preview-col">
      <div class="empty" id="empty">Generated images and live denoising steps will appear here.</div>
      <div class="gallery" id="gallery" style="display:none;"></div>
    </div>
  </div>

  <!-- Sticky Bottom Bar -->
  <div class="bottom-bar">
    <div class="bottom-inner">
      <div class="batch-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
          <polyline points="2 17 12 22 22 17"></polyline>
          <polyline points="2 12 12 17 22 12"></polyline>
        </svg>
        <select id="batch">
          <option value="1" selected>1</option>
          <option value="2">2</option>
          <option value="3">3</option>
          <option value="4">4</option>
        </select>
      </div>

      <button class="gen-btn" id="gbtn" onclick="gen()">Generate</button>

      <button class="gear-btn" onclick="settings_modal.classList.add('open')" title="LoRA & Sampling Settings">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="3"></circle>
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Settings Modal (LoRA, Steps, CFG) -->
  <div class="modal-bg" id="settings_modal" onclick="if(event.target===this)this.classList.remove('open')">
    <div class="modal">
      <div class="card-head">
        <span>LoRA &amp; Sampling</span>
        <button onclick="settings_modal.classList.remove('open')" style="background:none;border:none;color:var(--muted);cursor:pointer;font-size:14px;">Close</button>
      </div>
      <div class="range-group">
        <div class="range-label"><span>LoRA Source</span></div>
        <select id="l_mode" onchange="tLora()">
          <option value="none" selected>Not Selected (Base Model)</option>
          <option value="remote">Remote URL (.safetensors)</option>
          <option value="local">Drive LoRA</option>
        </select>
      </div>
      <div class="range-group" id="r_grp" style="display:none;">
        <div class="range-label"><span>Direct .safetensors URL</span></div>
        <input type="text" id="r_url" placeholder="https://huggingface.co/.../resolve/main/lora.safetensors" />
      </div>
      <div class="range-group" id="l_grp" style="display:none;">
        <div class="range-label"><span>Drive LoRA</span></div>
        <select id="l_lora">__LORA_OPTIONS__</select>
      </div>
      <div class="range-group" id="w_grp" style="display:none;">
        <div class="range-label"><span>LoRA Weight</span><span id="lwv">0.8</span></div>
        <input type="range" id="lw" min="0" max="1.5" step="0.05" value="0.8" oninput="lwv.innerText=this.value" />
      </div>
      <div class="range-group">
        <div class="range-label"><span>Sampling Steps</span><span id="sv">25</span></div>
        <input type="range" id="steps" min="15" max="40" value="25" oninput="sv.innerText=this.value" />
      </div>
      <div class="range-group">
        <div class="range-label"><span>CFG Scale</span><span id="cv">6.0</span></div>
        <input type="range" id="cfg" min="1" max="12" step="0.5" value="6.0" oninput="cv.innerText=this.value" />
      </div>
    </div>
  </div>

  <script>
    function applyPreset() {
      if (preset.value === "custom") return;
      const [w, h] = preset.value.split(",");
      w_in.value = w; h_in.value = h;
      updateResizeInfo();
    }
    function swapDims() {
      const tmp = w_in.value; w_in.value = h_in.value; h_in.value = tmp;
      preset.value = "custom";
      updateResizeInfo();
    }
    function updateResizeInfo() {
      const w = parseInt(w_in.value) || 832, h = parseInt(h_in.value) || 1216;
      resize_info.innerText = `resize: from ${w}x${h} to ${w*4}x${h*4} (4x)`;
    }
    function tLora() {
      const m = l_mode.value;
      r_grp.style.display = m === "remote" ? "flex" : "none";
      l_grp.style.display = m === "local" ? "flex" : "none";
      w_grp.style.display = m !== "none" ? "flex" : "none";
    }
    async function gen() {
      gbtn.disabled = true; status_text.innerText = "Starting...";
      empty.style.display = "none"; gallery.style.display = "grid"; gallery.innerHTML = "";
      const b = parseInt(batch.value), w = parseInt(w_in.value) || 832, h = parseInt(h_in.value) || 1216;
      const useAD = ad_toggle.checked;

      for (let i = 0; i < b; i++) {
        gallery.innerHTML += `<div class="img-card"><div class="badge" id="bg_${i}">Queued</div><img id="im_${i}" style="display:none;"/><div class="prog" id="pr_${i}"></div><div class="overlay" id="ov_${i}" style="display:none;"><span style="font-size:12px;">Saved</span><a class="dl-btn" id="dl_${i}" download="img_${i+1}.png">Download</a></div></div>`;
      }

      try {
        const r = await fetch("/generate_stream", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            prompt: prompt.value, neg_prompt: neg.value, width: w, height: h,
            steps: parseInt(steps.value), cfg: parseFloat(cfg.value), batch_count: b,
            lora_mode: l_mode.value, local_lora: l_lora.value || "", remote_url: r_url.value || "", lora_weight: parseFloat(lw.value),
            fix_face: useAD && face_chip.classList.contains("active"),
            fix_hand: useAD && hand_chip.classList.contains("active"),
            upscale: hr_toggle.checked
          })
        });
        const rd = r.body.getReader(), dec = new TextDecoder(); let buf = "";
        while (true) {
          const { value, done } = await rd.read(); if (done) break;
          buf += dec.decode(value, { stream: true });
          const lines = buf.split("\n\n"); buf = lines.pop();
          for (const ln of lines) {
            if (!ln.startsWith("data: ")) continue;
            const d = JSON.parse(ln.slice(6));
            if (d.type === "preview") {
              const im = document.getElementById(`im_${d.index}`);
              im.src = d.image; im.style.display = "block";
              document.getElementById(`bg_${d.index}`).innerText = `Step ${d.step}/${d.total_steps}`;
              document.getElementById(`pr_${d.index}`).style.width = `${(d.step/d.total_steps)*100}%`;
              status_text.innerText = `Denoising ${d.index+1}/${b}`;
            } else if (d.type === "status") {
              document.getElementById(`bg_${d.index}`).innerText = d.text;
              status_text.innerText = d.text;
            } else if (d.type === "final") {
              const im = document.getElementById(`im_${d.index}`);
              im.src = d.image; document.getElementById(`dl_${d.index}`).href = d.image;
              document.getElementById(`bg_${d.index}`).style.display = "none";
              document.getElementById(`pr_${d.index}`).style.display = "none";
              document.getElementById(`ov_${d.index}`).style.display = "flex";
            } else if (d.type === "done") { status_text.innerText = "Completed"; }
            else if (d.type === "error") { status_text.innerText = "Error: " + d.message; }
          }
        }
      } catch (e) { status_text.innerText = "Error: " + e; }
      finally { gbtn.disabled = false; }
    }
  </script>
</body>
</html>
